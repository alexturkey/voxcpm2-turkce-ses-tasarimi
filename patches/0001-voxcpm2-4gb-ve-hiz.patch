+static int64_t voxcpm2_kv_capacity(int64_t max_length) {
+  // anlatim GPU yamasi (a): KV kapasitesi max_length yerine verilen adim sayisi; ayarsizken davranis aynen kalir.
+  const char *value = std::getenv("VOXCPM2_KV_CAPACITY");
+  if (value == nullptr || value[0] == 0) { return max_length; }
+  // anlatim GPU yamasi (K5): "auto" -> kucuk yer tutucu; her istekte ensure_kv_capacity boyutlar.
+  if (std::string(value) == "auto") { return std::min<int64_t>(max_length, 64); }
+  const int64_t capacity = std::stoll(value);
+  if (capacity <= 0 || capacity > max_length) { throw std::invalid_argument("VOXCPM2_KV_CAPACITY must be in 1..max_length"); }
+  return capacity;
+}
