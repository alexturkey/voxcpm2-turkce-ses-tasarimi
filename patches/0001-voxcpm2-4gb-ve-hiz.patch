+    return false;
+  }
+  out.prompt_text.assign(static_cast<size_t>(text_size), '\0');
+  if (!file.read(out.prompt_text.data(), static_cast<std::streamsize>(text_size)) ||
+      !read_floats(file, out.prompt_features) ||
+      !file.read(reinterpret_cast<char *>(&out.prompt_patches), sizeof(out.prompt_patches)) ||
+      !read_floats(file, out.reference_features) ||
+      !file.read(reinterpret_cast<char *>(&out.reference_patches), sizeof(out.reference_patches))) {
+    return false;
+  }
+  uint32_t tail = 0;
+  return file.read(reinterpret_cast<char *>(&tail), sizeof(tail)) &&
+         tail == kPromptDiskCacheMagic;
+}
+
+void save_prompt_to_disk(const std::filesystem::path &path, const std::string &key_hex,
+                         const VoxCPM2EncodedPrompt &prompt) {
+  std::error_code ec;
+  std::filesystem::create_directories(path.parent_path(), ec);
+  auto temporary = path;
+  temporary += ".tmp";
+  {
+    std::ofstream file(temporary, std::ios::binary | std::ios::trunc);
+    if (!file) {
+      return;
+    }
+    file.write(reinterpret_cast<const char *>(&kPromptDiskCacheMagic), sizeof(kPromptDiskCacheMagic));
+    file.write(key_hex.data(), 64);
+    const uint64_t text_size = prompt.prompt_text.size();
+    file.write(reinterpret_cast<const char *>(&text_size), sizeof(text_size));
+    file.write(prompt.prompt_text.data(), static_cast<std::streamsize>(text_size));
+    write_floats(file, prompt.prompt_features);
+    file.write(reinterpret_cast<const char *>(&prompt.prompt_patches), sizeof(prompt.prompt_patches));
+    write_floats(file, prompt.reference_features);
+    file.write(reinterpret_cast<const char *>(&prompt.reference_patches), sizeof(prompt.reference_patches));
+    file.write(reinterpret_cast<const char *>(&kPromptDiskCacheMagic), sizeof(kPromptDiskCacheMagic));
+    if (!file) {
+      file.close();
+      std::filesystem::remove(temporary, ec);
+      return;
+    }
+  }
+  std::filesystem::rename(temporary, path, ec);
+  if (ec) {
+    std::filesystem::remove(temporary, ec);
+  }
 }
 
