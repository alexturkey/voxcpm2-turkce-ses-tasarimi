+  debug::trace_log_scalar("voxcpm2.internal." + name + ".rms", std::sqrt(squares / values.size()));
+  debug::trace_log_scalar("voxcpm2.internal." + name + ".max_abs", maximum);
+  debug::trace_log_scalar("voxcpm2.internal." + name + ".nonfinite", nonfinite);
+  if (full) {
+    std::ostringstream data;
+    data << std::setprecision(9) << '[';
+    for (size_t i = 0; i < values.size(); ++i) {
+      if (i) data << ',';
+      data << values[i];
+    }
+    data << ']';
+    debug::trace_log_scalar("voxcpm2.internal." + name + ".values", data.str());
+  }
