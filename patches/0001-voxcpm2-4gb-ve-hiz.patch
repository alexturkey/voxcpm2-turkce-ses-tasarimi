+
+bool VoxCPM2SessionBase::begin_deferred_decode_impl() {
+  // ahenk yama c5: VOXCPM2_TOPLU_COZ=1 ve GPU parcali cozme (4 GB yolu) aciksa
+  const char *flag = std::getenv("VOXCPM2_TOPLU_COZ");
+  const char *gpu_chunk = std::getenv("VOXCPM2_AUDIOVAE_GPU_CHUNK");
+  defer_decode_ = flag != nullptr && std::string(flag) == "1" &&
+                  gpu_chunk != nullptr && gpu_chunk[0] != 0 &&
+                  task_.mode == runtime::RunMode::Offline &&
+                  execution_context().backend_type() != engine::core::BackendType::Cpu;
+  pending_decodes_.clear();
+  return defer_decode_;
+}
+
+void VoxCPM2SessionBase::finish_deferred_decode_impl(
+    std::vector<runtime::TaskResult *> &results) {
+  defer_decode_ = false;
+  std::vector<runtime::TaskResult *> targets;
+  for (auto *result : results) {
+    if (result != nullptr && !result->audio_output.has_value()) {
+      targets.push_back(result);
+    }
+  }
+  if (targets.size() != pending_decodes_.size()) {
+    pending_decodes_.clear();
+    throw std::runtime_error("VoxCPM2 deferred decode count mismatch");
+  }
+  if (targets.empty()) {
+    return;
+  }
+  const auto release_start = Clock::now();
+  generator_.reset();
+  debug::timing_log_scalar("voxcpm2.audiovae.gpu_chunk.lm_release_ms",
+                           engine::debug::elapsed_ms(release_start));
+  const auto &vae = assets_->config.audio_vae;
+  const int64_t patch = assets_->config.patch_size;
+  const double frames_per_second =
+      static_cast<double>(vae.output_sample_rate) /
+      static_cast<double>(product(vae.decoder_rates));
+  int64_t overlap_frames = 32;
+  if (const char *overlap = std::getenv("VOXCPM2_AUDIOVAE_GPU_OVERLAP");
+      overlap != nullptr && overlap[0] != 0) {
+    overlap_frames = std::stoll(overlap);
+  }
+  const auto load_start = Clock::now();
+  VoxCPM2AudioVAEDecoderRuntime *gpu_decoder = decoder_.get();
+  std::unique_ptr<VoxCPM2AudioVAEDecoderRuntime> temporary;
+  if (audiovae_context_ != nullptr) {
+    temporary = std::make_unique<VoxCPM2AudioVAEDecoderRuntime>(
+        assets_, execution_context(), decoder_config_);
+    gpu_decoder = temporary.get();
+  } else {
+    decoder_->release_runtime_memory();
+  }
+  debug::timing_log_scalar("voxcpm2.audiovae.gpu_chunk.weights_load_ms",
+                           engine::debug::elapsed_ms(load_start));
+  const auto decode_start = Clock::now();
+  for (size_t i = 0; i < targets.size(); ++i) {
+    auto &pending = pending_decodes_[i];
+    if (!(pending.chunk_seconds > 0.0)) {
+      throw std::invalid_argument("VOXCPM2_AUDIOVAE_GPU_CHUNK must be positive seconds");
+    }
+    int64_t chunk_frames = std::llround(pending.chunk_seconds * frames_per_second);
+    chunk_frames = std::max<int64_t>(patch, ((chunk_frames + patch - 1) / patch) * patch);
+    auto audio = gpu_decoder->decode_features_chunked(pending.features, pending.patches,
+                                                      chunk_frames, overlap_frames);
+    if (const char *directory = std::getenv("VOXCPM2_PROBE_PCM_DIR")) {
+      auto dump = [&](const char *name, const std::vector<float> &values) {
+        std::ofstream file(std::filesystem::path(directory) / name, std::ios::binary);
+        file.write(reinterpret_cast<const char *>(values.data()), values.size() * sizeof(float));
+        if (!file) { throw std::runtime_error("Probe float dump failed"); }
+      };
+      dump("decode_features.f32", pending.features);
+      dump("decoded_pcm.f32", audio.samples);
+      std::ofstream meta(std::filesystem::path(directory) / "decode_shape.txt");
+      meta << pending.patches << " " << pending.trim_patches << " " << audio.sample_rate << " " << audio.samples.size() << "\n";
+    }
+    if (pending.trim_patches > 0) {
+      const int64_t trim_samples =
+          pending.trim_patches * patch * product(vae.decoder_rates);
+      if (trim_samples > static_cast<int64_t>(audio.samples.size())) {
+        throw std::runtime_error(
+            "VoxCPM2 decoded continuation trim exceeds audio length");
+      }
+      audio.samples.erase(
+          audio.samples.begin(),
+          audio.samples.begin() + static_cast<std::ptrdiff_t>(trim_samples));
+    }
+    runtime::AudioBuffer merged;
+    runtime::append_audio_buffer(merged, audio);
+    targets[i]->audio_output = std::move(merged);
+    pending.features.clear();
+    pending.features.shrink_to_fit();
+  }
+  debug::timing_log_scalar("voxcpm2.toplu_coz.decode_ms",
+                           engine::debug::elapsed_ms(decode_start));
+  debug::timing_log_scalar("voxcpm2.toplu_coz.lines",
+                           static_cast<double>(targets.size()));
+  pending_decodes_.clear();
+  temporary.reset();
+  decoder_->release_runtime_memory();
+}
+
+void VoxCPM2SessionBase::ensure_generator() {
+  if (generator_ == nullptr) {
+    generator_ = std::make_unique<VoxCPM2FeatureGeneratorRuntime>(
+        assets_, execution_context(), generator_config_);
+  }
+}
+
+runtime::AudioBuffer VoxCPM2SessionBase::decode_on_gpu_chunked(
+    const std::vector<float> &features, int64_t patches, double chunk_seconds) {
+  // anlatim GPU yamasi (K5): istegin son metin parcasi uretildi; LM agirliklari, KV ve
+  // grafikler VRAM'den bosaltilir (sonraki istekte ensure_generator yeniden kurar),
+  // AudioVAE GPU'da sol baglamli parcalarla cozulur.
+  if (!(chunk_seconds > 0.0)) {
+    throw std::invalid_argument("VOXCPM2_AUDIOVAE_GPU_CHUNK must be positive seconds");
+  }
+  const auto release_start = Clock::now();
+  generator_.reset();
+  debug::timing_log_scalar("voxcpm2.audiovae.gpu_chunk.lm_release_ms",
+                           engine::debug::elapsed_ms(release_start));
+  const auto &vae = assets_->config.audio_vae;
+  const int64_t patch = assets_->config.patch_size;
+  const double frames_per_second =
+      static_cast<double>(vae.output_sample_rate) /
+      static_cast<double>(product(vae.decoder_rates));
+  int64_t chunk_frames = std::llround(chunk_seconds * frames_per_second);
+  chunk_frames = std::max<int64_t>(patch, ((chunk_frames + patch - 1) / patch) * patch);
+  int64_t overlap_frames = 32;
+  if (const char *overlap = std::getenv("VOXCPM2_AUDIOVAE_GPU_OVERLAP");
+      overlap != nullptr && overlap[0] != 0) {
+    overlap_frames = std::stoll(overlap);
+  }
+  const auto load_start = Clock::now();
+  VoxCPM2AudioVAEDecoderRuntime *gpu_decoder = decoder_.get();
+  std::unique_ptr<VoxCPM2AudioVAEDecoderRuntime> temporary;
+  if (audiovae_context_ != nullptr) {
+    temporary = std::make_unique<VoxCPM2AudioVAEDecoderRuntime>(
+        assets_, execution_context(), decoder_config_);
+    gpu_decoder = temporary.get();
+  } else {
+    decoder_->release_runtime_memory();
+  }
+  debug::timing_log_scalar("voxcpm2.audiovae.gpu_chunk.weights_load_ms",
+                           engine::debug::elapsed_ms(load_start));
+  return gpu_decoder->decode_features_chunked(features, patches, chunk_frames,
+                                              overlap_frames);
 }
 
