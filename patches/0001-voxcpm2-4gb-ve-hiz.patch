+// anlatim GPU yamasi (K5): kod cozucunun nedensel sol alici alani (latent kare).
+// Ilk derinlemesine conv k7: 6 kare; her blokta ters conv (cekirdek 2*stride) bir
+// onceki giris karesi + uc artik birim 6*(1+3+9)=78 ornek; son conv k7: 6 ornek.
+int64_t decoder_receptive_field_frames(const std::vector<int64_t> &rates) {
+  double frames = 6.0;
+  double rate = 1.0;
+  for (const int64_t r : rates) {
+    frames += 1.0 / rate;
+    rate *= static_cast<double>(r);
+    frames += static_cast<double>((kResidualKernel - 1) * (1 + 3 + 9)) / rate;
+  }
+  frames += static_cast<double>(kResidualKernel - 1) / rate;
+  return static_cast<int64_t>(std::ceil(frames));
+}
