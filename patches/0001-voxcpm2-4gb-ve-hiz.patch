+class Sha256 {
+public:
+  Sha256() { reset(); }
+  void update(const void *data, size_t size) {
+    const auto *bytes = static_cast<const uint8_t *>(data);
+    for (size_t i = 0; i < size; ++i) {
+      block_[block_size_++] = bytes[i];
